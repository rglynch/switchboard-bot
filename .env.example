# ── Required ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_token_from_botfather

# ── LLM Providers (configure one or more) ────────────────────────────
# Which provider /ask uses by default: claude, gpt, grok, or perplexity
LLM_DEFAULT=grok

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

GROK_API_KEY=
GROK_MODEL=grok-4.1-fast

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# ── Model restrictions (optional) ────────────────────────────────────
# Comma-separated list of allowed shortcuts and/or full model strings.
# If set, users can ONLY use these models for that provider.
# If not set, all models are available.
# Supports both shortcuts (haiku) and full strings (claude-sonnet-4-6).
ALLOWED_MODELS_CLAUDE=haiku
ALLOWED_MODELS_GPT=mini
ALLOWED_MODELS_GROK=fast
ALLOWED_MODELS_PERPLEXITY=sonar
# To open up more models later, just add them:
# ALLOWED_MODELS_CLAUDE=haiku,sonnet
# ALLOWED_MODELS_CLAUDE=haiku,claude-sonnet-4-6

# ── Search (Brave primary, DuckDuckGo fallback) ──────────────────────
# Without this, search falls back to DuckDuckGo (free but can't turn safe search off for images)
# Sign up at: api-dashboard.search.brave.com
# Free: $5 credits/month (~1000 queries), auto-applied. Safe search fully configurable.
BRAVE_API_KEY=

# ── Finnhub (optional — real-time US stock quotes) ───────────────────
FINNHUB_API_KEY=

# ── Songlink (optional — works without key) ──────────────────────────
SONGLINK_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────
# ALLOWED_CHAT_IDS=chat_id_1, chat_id_2
# LOG_LEVEL=INFO

# ── Monthly usage limits (requests per month, empty = unlimited) ─────
# MONTHLY_LIMIT_CLAUDE=200
# MONTHLY_LIMIT_GPT=200
# MONTHLY_LIMIT_GROK=500
# MONTHLY_LIMIT_PERPLEXITY=100
# USAGE_WARN_PCT=80
